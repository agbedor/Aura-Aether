# Supabase PostgreSQL connection used by Prisma.
# Copy the Session Pooler connection string from Supabase > Connect.
# Replace this placeholder locally; never commit your real .env file or credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Used only by the Supabase JavaScript client (not required for Prisma itself).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Required by authentication.
AUTH_SECRET="replace-with-a-long-random-secret"

# Required for CMS image uploads (Supabase Storage).
# Create a PUBLIC bucket named product-images in Supabase > Storage.
SUPABASE_STORAGE_BUCKET="product-images"
# Copy the service_role key from Supabase API settings. Server-side only; never expose or commit the real key.
SUPABASE_SERVICE_ROLE_KEY=


# Optional contact-form email alerts via Resend.
# Messages are saved to PostgreSQL even when email alerts are not configured.
RESEND_API_KEY="your_resend_api_key"
CONTACT_TO_EMAIL="your_inbox@example.com"
CONTACT_FROM_EMAIL="Aura & Aether <onboarding@resend.dev>"
