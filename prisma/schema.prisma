// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CUSTOMER") // "CUSTOMER" | "ADMIN"
  phone     String?
  address   String?
  city      String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  description   String
  price         Float
  originalPrice Float?
  size          String
  stock         Int         @default(10)
  inStock       Boolean     @default(true)
  isFeatured    Boolean     @default(false)
  isGiftSet     Boolean     @default(false)
  isSale        Boolean     @default(false)
  scentNotes    String      @default("FLORAL & AIRY")
  topNotes      String?
  heartNotes    String?
  baseNotes     String?
  image         String
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([slug])
  @@index([categoryId])
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  userId           String?
  user             User?       @relation(fields: [userId], references: [id])
  customerName     String
  customerEmail    String
  customerPhone    String
  deliveryAddress  String
  city             String
  notes            String?
  subtotal         Float
  deliveryFee      Float
  totalAmount      Float
  status           String      @default("PENDING") // PENDING, PAID, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  paymentStatus    String      @default("PENDING") // PENDING, SUCCESS, FAILED, REVERSED
  paymentReference String      @unique
  items            OrderItem[]
  payment          Payment?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId])
  @@index([paymentReference])
  @@index([status])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  productName  String
  productPrice Float
  quantity     Int
  size         String?
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id          String    @id @default(cuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reference   String    @unique
  paystackId  String?
  amount      Float
  currency    String    @default("GHS")
  status      String    @default("PENDING") // PENDING, SUCCESS, FAILED, REVERSED
  channel     String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([reference])
}


model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}
